# Copie para .env e ajuste. O Expo só expõe ao app variáveis com prefixo EXPO_PUBLIC_.
# mock (padrão) ou api (a partir do M6)
EXPO_PUBLIC_DATA_SOURCE=mock
# URL base da API (ainda não confirmada pela professora como oficial)
EXPO_PUBLIC_API_BASE_URL=https://internet-quality-api.onrender.com
EXPO_PUBLIC_DEFAULT_MODEL_ID=model-a
